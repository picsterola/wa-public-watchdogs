---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import AllegationBanner from '../../components/AllegationBanner.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatDate, formatDollars, SEVERITY_LABELS, STATUS_LABELS, STATUS_LABELS_LONG, LEGAL_STATUS_LABELS, REMEDIATION_LABELS, REMEDIATION_VERDICTS, REFORM_STATUS_LABELS, ROLE_LABELS, SOURCE_TYPE_LABELS, humanizeReform, caseGroup, GROUP_SLUG } from '../../lib/format';
import { agencySlugFromName, AGENCY_BY_SLUG } from '../../lib/agencies';
import { REFORM_BY_SLUG } from '../../lib/reforms';
import officialsData from '../../data/officials.json';

const OFFICIALS = officialsData.officials as Record<string, { name: string; title: string; photo: string | null; source_url: string | null; license: string | null }>;
function officialSlug(name: string): string {
  return name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
// Faces of officials surface only on Documented + Reported cases (not Alleged, not Retracted).
function shouldShowFaces(evidentiaryStatus: string, isRetracted: boolean): boolean {
  if (isRetracted) return false;
  return evidentiaryStatus === 'documented' || evidentiaryStatus === 'reported';
}

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((c) => ({
    params: { slug: c.slug },
    props: { entry: c, all: cases },
  }));
}

type Props = { entry: CollectionEntry<'cases'>; all: CollectionEntry<'cases'>[] };
const { entry, all } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

// === Paragraph splitter ===
// Long-form text fields (reform_argument, dollars_basis, outcome_summary,
// remediation_note) are authored in YAML as block scalars (|) where a blank
// line is meant to indicate a paragraph break. Split on one-or-more blank
// lines, normalize single line-breaks within each paragraph to spaces,
// and drop empties. Renderer wraps each result in its own <p>.
function toParagraphs(text: string | null | undefined): string[] {
  if (!text) return [];
  return text
    .split(/\n[\t ]*\n+/)
    .map((p) => p.replace(/\s+/g, ' ').trim())
    .filter((p) => p.length > 0);
}

// === Related cases ===
// Score every other (non-retracted, non-this) case by overlap on agency,
// reform, and severity. We keep the top 4. The intent is internal linking
// for SEO and to give readers a next step, not exhaustive related-content.
const thisAgencySlugs = new Set(
  d.actors.filter((a) => a.role_type === 'agency').map((a) => agencySlugFromName(a.name)),
);
const thisReforms = new Set(d.reforms_implicated ?? []);
const thisSeverities = new Set(d.severity_type ?? []);
function scoreRelated(c: CollectionEntry<'cases'>): number {
  if (c.slug === entry.slug) return -1;
  if (c.data.review_status === 'retracted') return -1;
  const otherAgencies = new Set(
    c.data.actors.filter((a) => a.role_type === 'agency').map((a) => agencySlugFromName(a.name)),
  );
  let score = 0;
  for (const s of otherAgencies) if (thisAgencySlugs.has(s)) score += 3;
  for (const r of c.data.reforms_implicated ?? []) if (thisReforms.has(r)) score += 2;
  for (const s of c.data.severity_type ?? []) if (thisSeverities.has(s)) score += 1;
  return score;
}
const relatedCases = all
  .map((c) => ({ c, score: scoreRelated(c) }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.c.data.date_surfaced.getTime() - a.c.data.date_surfaced.getTime())
  .slice(0, 4)
  .map((x) => x.c);

// === Curated agency / reform deep-links for the sidebar ===
const curatedAgencies = Array.from(thisAgencySlugs)
  .filter((s) => s in AGENCY_BY_SLUG)
  .map((s) => AGENCY_BY_SLUG[s]);
const curatedReforms = (d.reforms_implicated ?? []).filter((r) => r in REFORM_BY_SLUG);
const isRetracted = d.review_status === 'retracted';
const jurisdictions = Array.from(new Set(d.actors.map((a) => a.jurisdiction)));
const group = caseGroup(d.actors);
const groupHref = `/cases?group=${encodeURIComponent(group)}#group-${GROUP_SLUG[group]}`;

// Structured data: schema.org Report. Cases are documented findings with
// primary-source citations, which maps cleanly to Report. Retracted records
// are explicitly marked so search engines do not promote them.
function toISODate(v: unknown): string | undefined {
  if (!v) return undefined;
  if (v instanceof Date) return v.toISOString().slice(0, 10);
  if (typeof v === 'string' || typeof v === 'number') {
    const dt = new Date(v as any);
    return isNaN(dt.getTime()) ? undefined : dt.toISOString().slice(0, 10);
  }
  return undefined;
}
const SITE_URL = 'https://wacountability.org';
const caseUrl = `${SITE_URL}/cases/${entry.slug}.html`;
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Report',
  '@id': caseUrl,
  url: caseUrl,
  name: d.title,
  headline: d.title,
  identifier: d.id,
  inLanguage: 'en',
  isAccessibleForFree: true,
  datePublished: toISODate(d.date_surfaced),
  dateModified: toISODate(d.last_updated) ?? toISODate(d.date_surfaced),
  author: { '@type': 'Organization', name: 'Washington Accountability Registry', url: SITE_URL },
  publisher: { '@type': 'Organization', name: 'Washington Accountability Registry', url: SITE_URL },
  about: d.actors.map((a) => ({
    '@type': a.role_type === 'agency' ? 'GovernmentOrganization' : 'Person',
    name: a.name,
    ...(a.title ? { jobTitle: a.title } : {}),
  })),
  keywords: [...(d.tags ?? []), ...d.severity_type, ...jurisdictions].join(', '),
  citation: d.sources.map((s) => ({
    '@type': 'CreativeWork',
    name: s.title,
    ...(s.url ? { url: s.url } : {}),
    ...(s.publisher ? { publisher: { '@type': 'Organization', name: s.publisher } } : {}),
    ...(s.author ? { author: { '@type': 'Person', name: s.author } } : {}),
    ...(toISODate(s.date as any) ? { datePublished: toISODate(s.date as any) } : {}),
  })),
  image: `${SITE_URL}/og/${entry.slug}.png`,
  mainEntityOfPage: caseUrl,
  creativeWorkStatus: isRetracted ? 'Retracted' : (d.legal_status ?? 'documented'),
};
---
<Base title={d.title} description={d.title} ogImage={`/og/${entry.slug}.png`} jsonLd={jsonLd}>
  <Breadcrumb items={[
    { label: 'Cases', href: '/cases' },
    { label: group, href: groupHref },
    { label: d.id },
  ]} />

  {isRetracted && (
    <div class="tombstone" role="alert">
      <h2>This case has been retracted</h2>
      <p>{d.retraction_note ?? 'This record has been retracted. The page is preserved for transparency.'}</p>
      <p class="small muted">Record ID: {d.id} · Originally surfaced {formatDate(d.date_surfaced)} · Retracted as of {formatDate(d.last_updated)}.</p>
    </div>
  )}

  <article class="case-detail">
    <div>
      {!isRetracted && <AllegationBanner status={d.evidentiary_status} />}
      <header class="case-header">
        <div class="case-id">{d.id}</div>
        <h1 class="case-title">{d.title}</h1>
        <div class="case-header-badges">
          <span class={`badge badge-${d.evidentiary_status}`}>{STATUS_LABELS_LONG[d.evidentiary_status] ?? STATUS_LABELS[d.evidentiary_status]}</span>
          {d.severity_type.map((s) => (
            <span class="badge badge-severity">{SEVERITY_LABELS[s] ?? s}</span>
          ))}
          {isRetracted && <span class="badge badge-retracted">Retracted</span>}
        </div>
      </header>

      {!isRetracted && (
        <div class="case-body prose">
          <Content />
        </div>
      )}

      {!isRetracted && d.reform_argument && (
        <section class="reform-callout" aria-label="Reform implication">
          <h3>Reform implication</h3>
          {toParagraphs(d.reform_argument).map((p) => <p>{p}</p>)}
          {d.reforms_implicated.length > 0 && (
            <div class="reform-tags">
              {d.reforms_implicated.map((r) => (
                <a class="reform-tag" href={r in REFORM_BY_SLUG ? `/reforms/${r}.html` : `/reforms.html#${r}`}>{humanizeReform(r)}</a>
              ))}
            </div>
          )}
        </section>
      )}

      {!isRetracted && d.sources.length > 0 && (
        <section class="sources-section" aria-label="Sources">
          <h2 style="font-family: var(--font-sans); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-muted); border-bottom: 1px solid var(--rule); padding-bottom: 0.5rem;">Sources</h2>
          <ol class="sources-list">
            {d.sources.map((s) => (
              <li class="source-item">
                <div>
                  <div class="source-meta">
                    <span class={`badge badge-tier badge-tier-${s.tier}`}>Tier {s.tier}</span>
                    <span>{SOURCE_TYPE_LABELS[s.type] ?? s.type}</span>
                    {s.publisher && <><span class="sep">·</span><span>{s.publisher}</span></>}
                    {s.author && <><span class="sep">·</span><span>{s.author}</span></>}
                    {s.date && <><span class="sep">·</span><span>{typeof s.date === 'string' || typeof s.date === 'number' ? s.date : formatDate(s.date)}</span></>}
                  </div>
                  <div class="source-title">{s.title}</div>
                  {s.quote && <div class="source-quote">“{s.quote}”</div>}
                  <div class="source-links">
                    {s.url && <a href={s.url} target="_blank" rel="noopener noreferrer">Primary →</a>}
                    {s.archive_url && <a href={s.archive_url} target="_blank" rel="noopener noreferrer">Archived copy →</a>}
                    {!s.archive_url && s.tier === 1 && <span class="muted small">No archive copy yet</span>}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>

    <aside class="sidebar" aria-label="Case metadata">
      <div class="sidebar-block">
        <h3>Actors</h3>
        {d.actors.map((a) => {
          const showFace = shouldShowFaces(d.evidentiary_status, isRetracted);
          const official = showFace ? OFFICIALS[officialSlug(a.name)] : undefined;
          const hasPhoto = official && official.photo;
          if (hasPhoto) {
            return (
              <div class="actor-card">
                <img class="actor-photo" src={official.photo} alt={`Portrait of ${official.name}`} width="56" height="56" loading="lazy" />
                <div class="actor-text">
                  <div class="actor-name">{a.name}</div>
                  {a.title && <div class="actor-title sub">{a.title}</div>}
                  <div class="sub">
                    {ROLE_LABELS[a.role_type] ?? a.role_type}
                    {a.party && ` · ${a.party}`}
                    {a.jurisdiction && ` · ${a.jurisdiction}`}
                  </div>
                  {official.source_url && (
                    <div class="actor-photo-credit">
                      <a href={official.source_url} target="_blank" rel="noopener noreferrer">photo</a>
                    </div>
                  )}
                </div>
              </div>
            );
          }
          return (
            <p class="value">
              {a.name}
              {a.title && <span class="sub">{a.title}</span>}
              <span class="sub">
                {ROLE_LABELS[a.role_type] ?? a.role_type}
                {a.party && ` · ${a.party}`}
                {a.jurisdiction && ` · ${a.jurisdiction}`}
              </span>
            </p>
          );
        })}
      </div>

      <div class="sidebar-block">
        <h3>Jurisdiction</h3>
        <p class="value">{jurisdictions.join(', ')}</p>
      </div>

      {curatedAgencies.length > 0 && (
        <div class="sidebar-block">
          <h3>Agency record</h3>
          {curatedAgencies.map((a) => (
            <p class="value"><a href={`/agencies/${a.slug}.html`}>All {a.short ?? a.name} cases →</a></p>
          ))}
        </div>
      )}

      <div class="sidebar-block">
        <h3>Date surfaced</h3>
        <p class="value">{formatDate(d.date_surfaced)}</p>
      </div>

      <div class="sidebar-block">
        <h3>Last updated</h3>
        <p class="value">{formatDate(d.last_updated)}</p>
      </div>

      <div class="sidebar-block">
        <h3>Dollars at issue</h3>
        <p class="value">{formatDollars(d.dollars_at_issue)}</p>
        {toParagraphs(d.dollars_basis).map((p) => <p class="sub">{p}</p>)}
        {d.dollars_confirmed_loss != null && (
          <p class="sub">Confirmed loss: {formatDollars(d.dollars_confirmed_loss)}</p>
        )}
      </div>

      <div class="sidebar-block">
        <h3>Legal status</h3>
        <p class="value">{LEGAL_STATUS_LABELS[d.legal_status] ?? d.legal_status}</p>
        {toParagraphs(d.outcome_summary).map((p) => <p class="sub">{p}</p>)}
      </div>

      {(d.remediation_status !== 'unknown' || d.reform_status !== 'unknown' || d.next_milestone) && (
        <div class={`sidebar-block resolution-block resolution-${d.remediation_status}`}>
          <h3>Resolution</h3>
          {d.remediation_status !== 'unknown' && (
            <>
              <p class="value">{REMEDIATION_LABELS[d.remediation_status] ?? d.remediation_status}</p>
              <p class="sub resolution-verdict">{REMEDIATION_VERDICTS[d.remediation_status]}</p>
              {toParagraphs(d.remediation_note).map((p) => <p class="sub">{p}</p>)}
            </>
          )}
          {d.reform_status && d.reform_status !== 'unknown' && (
            <p class="sub resolution-reform">
              <span class="resolution-reform-label">Reform:</span> {REFORM_STATUS_LABELS[d.reform_status] ?? d.reform_status}
              {d.reform_status_note && <span> · {d.reform_status_note}</span>}
            </p>
          )}
          {d.next_milestone && (
            <p class="sub resolution-milestone">
              <span class="resolution-reform-label">Next:</span> {d.next_milestone}
              {d.next_milestone_date && <span> · {formatDate(d.next_milestone_date as any)}</span>}
            </p>
          )}
        </div>
      )}

      {d.tags.length > 0 && (
        <div class="sidebar-block">
          <h3>Tags</h3>
          <p class="value sub">{d.tags.join(', ')}</p>
        </div>
      )}
    </aside>
  </article>

  {!isRetracted && (() => {
    const shareTitle = d.title.replace(/—/g, '-');
    const shareUrl = 'https://wacountability.org';
    const shareText = `Washington Accountability Registry: ${shareTitle}. From the registry tracking ${d.id} and other open accountability cases across WA.`;
    const bskyHref = `https://bsky.app/intent/compose?text=${encodeURIComponent(shareText + ' ' + shareUrl)}`;
    const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`;
    return (
      <section class="case-share" aria-label="Share this case">
        <div class="case-share-label">Send this to someone who should know.</div>
        <div class="case-share-row">
          <a class="case-share-btn" href={bskyHref} target="_blank" rel="noopener">Share on Bluesky</a>
          <a class="case-share-btn" href={xHref} target="_blank" rel="noopener">Share on X</a>
          <a class="case-share-btn" href={`mailto:?subject=${encodeURIComponent('Washington Accountability Registry: ' + shareTitle)}&body=${encodeURIComponent(shareText + '\n\n' + shareUrl)}`}>Email</a>
        </div>
      </section>
    );
  })()}

  {!isRetracted && relatedCases.length > 0 && (
    <section class="related-cases" aria-label="Related cases">
      <h2 class="related-cases-title">Related cases</h2>
      <p class="related-cases-sub">Other registry entries that share an agency, a reform implication, or a similar pattern.</p>
      <ol class="related-cases-list">
        {relatedCases.map((c) => (
          <li class="related-case-item">
            <a class="related-case-link" href={`/cases/${c.slug}.html`}>
              <div class="related-case-meta">
                <span>{c.data.id}</span>
                <span class="sep">·</span>
                <span>{formatDate(c.data.date_surfaced)}</span>
                {c.data.dollars_at_issue != null && (
                  <><span class="sep">·</span><span>{formatDollars(c.data.dollars_at_issue)}</span></>
                )}
              </div>
              <div class="related-case-title">{c.data.title}</div>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <nav class="case-foot-nav" aria-label="Case page navigation">
    <a href="/cases">← All cases</a>
    <a href={groupHref}>More {group} cases →</a>
  </nav>
</Base>

<style>
  .related-cases { max-width: 880px; margin: 2.5rem auto 1rem; padding: 0 1rem; }
  .related-cases-title {
    font-family: var(--font-sans); font-size: 0.85rem; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--ink-muted);
    border-bottom: 1px solid var(--rule); padding-bottom: 0.5rem; margin: 0;
  }
  .related-cases-sub { font-size: 0.95rem; color: var(--ink-muted); margin: 0.6rem 0 1rem; }
  .related-cases-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .related-case-link {
    display: block; text-decoration: none; color: inherit;
    border: 1px solid var(--rule); border-radius: 6px; padding: 0.8rem 1rem;
    transition: border-color 120ms ease, background 120ms ease;
  }
  .related-case-link:hover { border-color: var(--accent); background: var(--bg-elev); }
  .related-case-meta {
    font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-muted);
    display: flex; gap: 0.4rem; flex-wrap: wrap;
  }
  .related-case-meta .sep { color: var(--rule-strong); }
  .related-case-title {
    font-family: var(--font-serif); font-size: 1.02rem; line-height: 1.35; margin-top: 0.25rem;
  }
</style>

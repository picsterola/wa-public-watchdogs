---
const year = new Date().getFullYear();
// Public canonical URL. When the custom domain is in place, update this in
// one spot and the share links will follow.
const SITE_URL = 'https://picsterola.github.io/wa-public-watchdogs';
const shareText = 'Washington Accountability Registry — every open accountability case across WA state, county, and Seattle government, in one place.';
const bskyHref = `https://bsky.app/intent/compose?text=${encodeURIComponent(shareText + ' ' + SITE_URL)}`;
const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(SITE_URL)}`;
---
<footer class="site-footer">
  <div class="page site-footer-inner">
    <div class="site-footer-block">
      <div class="site-footer-title">Washington Accountability Registry</div>
      <div class="site-footer-meta">Independent. No political party. No donations accepted. Sourced from public records.</div>
      <div class="site-footer-meta">{year} · Public Ledger · Refreshed Monthly</div>
    </div>
    <div class="site-footer-block site-footer-share">
      <div class="site-footer-title">Spread the word</div>
      <div class="site-footer-meta">A watchdog only works if people are watching.</div>
      <div class="site-footer-share-row">
        <a class="site-footer-share-btn" href={bskyHref} target="_blank" rel="noopener">Share on Bluesky</a>
        <a class="site-footer-share-btn" href={xHref} target="_blank" rel="noopener">Share on X</a>
      </div>
    </div>
    <div class="site-footer-block site-footer-nav">
      <div class="site-footer-title">Project</div>
      <a href="/methodology">Methodology</a>
      <a href="/corrections">Corrections</a>
      <a href="/about">About</a>
      <a href="mailto:corrections@wa-public-watchdogs.example?subject=Correction%20request%20or%20right%20of%20response">Request a correction or response</a>
    </div>
  </div>
</footer>
